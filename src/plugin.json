{
  "name": "Logo Library",
  "version": "0.1.0",
  "description": "Map logos from local external catalogs to Dispatcharr channels",
  "author": "sethwv",
  "license": "MIT",
  "manifest_version": 2,
  "min_dispatcharr_version": "v0.34.0",
  "capabilities": ["background_tasks", "persistent_service", "outbound_network", "filesystem_write"],
  "actions": [
    {
      "id": "apply_changes",
      "label": "Apply changes",
      "description": "Apply saved channel mappings and replace existing channel logos.",
      "button_label": "Apply changes",
      "async": true
    },
    {
      "id": "update_catalog",
      "label": "Refresh TV Logos library",
      "description": "Download the latest tv-logos catalog.",
      "button_label": "Refresh TV Logos library",
      "button_color": "teal",
      "async": true
    }
  ],
  "repo_url": "https://github.com/swvn-dispatch/logo-library",
  "help_url": "https://github.com/swvn-dispatch/logo-library"
}
